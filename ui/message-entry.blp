using Gtk 4.0;

template $AppWidgetsMessageEntry : Gtk.Box {
  orientation: horizontal;
  spacing: 8;
  margin-start: 18;
  margin-end: 18;
  margin-top: 10;
  margin-bottom: 14;

  Gtk.Entry entry {
    placeholder-text: _("Write a message");
    hexpand: true;
  }

  Gtk.Box emoji_slot {
    name: "emoji-slot";
  }

  Gtk.Button send_button {
    label: _("Send");
    css-classes: ["suggested-action"];
  }
}